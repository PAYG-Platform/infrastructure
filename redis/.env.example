# ==============================================================================
# REDIS HOST NETWORK BINDING
# ==============================================================================
# Set to '0.0.0.0' if firewall-restricted, or a private mesh IP (e.g. '10.10.0.11')
BIND_IP=0.0.0.0

# ==============================================================================
# REDIS AUTHENTICATION & PORT
# ==============================================================================
# Generate a strong password with: openssl rand -hex 24
REDIS_PASSWORD=replace_with_32_char_high_entropy_secret

# Redis Ingress Port (Default: 6379)
REDIS_PORT=6379

# ==============================================================================
# CONNECTION STRINGS FOR MICROSERVICES
# ==============================================================================
# Encrypted (Rediss): rediss://:${REDIS_PASSWORD}@<REDIS_SERVER_IP>:6379/0
# Plaintext (Redis):  redis://:${REDIS_PASSWORD}@<REDIS_SERVER_IP>:6379/0