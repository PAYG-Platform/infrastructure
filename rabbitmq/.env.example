# ==============================================================================
# RABBITMQ HOST NETWORK BINDING
# ==============================================================================
# Set to '0.0.0.0' if firewall-restricted, or a private mesh IP (e.g. '10.10.0.10')
BIND_IP=0.0.0.0

# ==============================================================================
# RABBITMQ CREDENTIALS & PORTS
# ==============================================================================
RMQ_USER=admin
RMQ_PASSWORD=replace_with_32_char_high_entropy_secret

# Plaintext AMQP Port (for private networks)
RMQ_PORT=5672

# Native Encrypted AMQPS (TLS) Port (for public internet)
RMQ_SSL_PORT=5671

# Web Management UI (Bound strictly to localhost 127.0.0.1 for SSH tunneling)
RMQ_MGMT_PORT=15672

# ==============================================================================
# CONNECTION STRINGS FOR MICROSERVICES
# ==============================================================================
# Encrypted: amqps://${RMQ_USER}:${RMQ_PASSWORD}@<RABBITMQ_SERVER_IP>:5671/
# Plaintext: amqp://${RMQ_USER}:${RMQ_PASSWORD}@<RABBITMQ_SERVER_IP>:5672/