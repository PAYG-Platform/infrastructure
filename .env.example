# ==============================================================================
# GLOBAL NETWORK & HOST BINDING
# ==============================================================================
# Set to '0.0.0.0' if running behind UFW / Cloud Security Groups.
# Set to private WireGuard IP (e.g., '10.10.0.10') if using an encrypted private mesh.
BIND_IP=0.0.0.0

# ==============================================================================
# RABBITMQ MESSAGE BROKER CONFIGURATION
# ==============================================================================
# Default Administrator account credentials
RMQ_USER=admin
RMQ_PASSWORD=replace_with_32_char_high_entropy_secret

# Standard Plaintext AMQP Listener Port (Default: 5672)
RMQ_PORT=5672

# Encrypted AMQPS (TLS/SSL) Listener Port (Default: 5671)
RMQ_SSL_PORT=5671

# Web Management Dashboard Port (Strictly bound to 127.0.0.1 on the host)
RMQ_MGMT_PORT=15672

# ==============================================================================
# REDIS CACHE & STATE STORE CONFIGURATION
# ==============================================================================
# High-entropy Redis authentication password (requirepass)
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace_with_32_char_high_entropy_secret

# Redis Ingress Port (Default: 6379)
REDIS_PORT=6379

# ==============================================================================
# CLIENT CONNECTION STRINGS (For your external microservice .env files)
# ==============================================================================
# --- Option A: Encrypted TLS/SSL (For Public Internet / Cloud WAN) ---
# RABBITMQ_URL=amqps://${RMQ_USER}:${RMQ_PASSWORD}@<THIS_SERVER_IP>:5671/
# REDIS_URL=rediss://:${REDIS_PASSWORD}@<THIS_SERVER_IP>:6379/0

# --- Option B: Plaintext (For Private WireGuard / VPC Networks) ---
# RABBITMQ_URL=amqp://${RMQ_USER}:${RMQ_PASSWORD}@<THIS_SERVER_IP>:5672/
# REDIS_URL=redis://:${REDIS_PASSWORD}@<THIS_SERVER_IP>:6379/0